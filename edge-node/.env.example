# DNS Shield — Edge Node / variáveis de ambiente
# Copie para `.env` e preencha. NUNCA versione o .env preenchido.

# Fuso horário do dispositivo
TZ=America/Sao_Paulo

# --- Pi-hole (DNS + DHCP da rede Wi-Fi criada pelo Pi via hostapd) ---
# Senha do painel admin (use uma senha forte e exclusiva por cliente)
WEBPASSWORD=troque_esta_senha

# Faixa de IPs distribuída na rede Wi-Fi "DNS-Shield" (sub-rede do hostapd).
DHCP_START=192.168.50.100
DHCP_END=192.168.50.200
# Gateway = o próprio Pi (IP do Access Point, ver hostapd/setup-access-point.sh).
DHCP_ROUTER=192.168.50.1

# --- DDNS (cliente) ---
# URL de atualização chamada periodicamente pelo cliente DDNS do Edge.
# O servidor que recebe isto é uma instância de pboehm/ddns na SUA nuvem.
# Ex.: https://ddns.suaempresa.com/update?token=TOKEN_EXCLUSIVO_DO_CLIENTE
DDNS_URL=https://ddns.suaempresa.com/update?token=TOKEN_EXCLUSIVO_DO_CLIENTE
# Intervalo (segundos) entre atualizações de IP.
DDNS_INTERVAL=300

# --- Backend (local ou nuvem) ---
# Identificador único do cliente (tenant) usado nos relatórios.
TENANT_ID=clinica-centro
# Endpoint da API NestJS que recebe a topologia descoberta.
# No MVP aponta para o backend local; na escala, para a nuvem.
CLOUD_API_URL=http://localhost:3000/api
