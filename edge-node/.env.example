# DNS Shield — Edge Node / variáveis de ambiente
# Copie para `.env` e preencha. NUNCA versione o .env preenchido.

# Fuso horário do dispositivo
TZ=America/Sao_Paulo

# --- Pi-hole ---
# Senha do painel admin (use uma senha forte e exclusiva por clínica)
WEBPASSWORD=troque_esta_senha

# Faixa de IPs que o Pi-hole vai distribuir via DHCP
DHCP_START=192.168.1.100
DHCP_END=192.168.1.200
# Gateway da rede (IP do roteador da operadora)
DHCP_ROUTER=192.168.1.1

# --- DDNS (pboehm/ddns) ---
# URL de atualização com o token exclusivo desta clínica.
# Ex.: https://ddns.suaempresa.com/update?token=TOKEN_EXCLUSIVO_DA_CLINICA
DDNS_URL=https://ddns.suaempresa.com/update?token=TOKEN_EXCLUSIVO_DA_CLINICA

# --- Backend (local ou nuvem) ---
# Identificador único da clínica (tenant) usado nos relatórios.
TENANT_ID=clinica-centro
# Endpoint da API NestJS que recebe a topologia descoberta.
# No MVP aponta para o backend local; na escala, para a nuvem.
CLOUD_API_URL=http://localhost:3000/api
