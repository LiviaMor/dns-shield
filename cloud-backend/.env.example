# DNS Shield — Cloud Backend (NestJS) / variáveis de ambiente
# Copie para `.env`. Tudo abaixo roda sem nuvem e sem custo.

PORT=3000

# Banco local (SQLite). Um arquivo, zero config.
DB_PATH=./data/dns-shield.db

# --- Escala opcional (deixe em branco no MVP) ---
# WhatsApp: URL do provedor para drenar a outbox (ex.: Evolution API self-host).
WHATSAPP_API_URL=

# --- IA LOCAL (Llama via Ollama) — privacidade por design ---
# A inferência roda localmente; nenhum dado de rede sai do dispositivo.
# Ative com true para refinar a análise/onboarding com o Llama.
LLM_ENABLED=false
# Endpoint do Ollama local (no compose da demo: http://ollama:11434).
LLM_API_URL=http://localhost:11434
# Modelo Llama a usar (ex.: llama3.2, llama3.2:1b para hardware fraco).
LLM_MODEL=llama3.2

